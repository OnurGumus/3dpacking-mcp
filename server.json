{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ing.3dpack/container-loading",
  "title": "3DPACK.ING — Container & Truck Load Planning",
  "description": "Container load planning in Claude & ChatGPT: what fits, how full, a labelled 3D plan in the chat.",
  "version": "0.4.0",
  "websiteUrl": "https://3dpack.ing",
  "icons": [
    {
      "src": "https://3dpack.ing/assets/icons/mark-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://3dpack.ing/assets/icons/mark.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/OnurGumus/3dpacking-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://3dpack.ing/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@3dpacking/mcp-server",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
